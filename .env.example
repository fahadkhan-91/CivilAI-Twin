# CivilAI Twin Configuration
# Copy this file to .env and fill in your API keys

# ===== AI Configuration =====
# AI Mode: 'openai', 'gemini', 'local', or 'builtin'
AI_MODE=builtin

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-pro

# Local LLM Configuration (if using local AI)
LOCAL_LLM_PATH=models/local_model.gguf
LOCAL_LLM_TYPE=llama

# ===== Application Settings =====
# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Theme: light, dark, system
APP_THEME=system

# Language: en, hi (Hindi), es (Spanish)
APP_LANGUAGE=en

# ===== Analysis Settings =====
# Units: metric, imperial
UNITS_SYSTEM=metric

# Code Standards: IS (Indian), ACI (American), BS (British), EURO
CODE_STANDARD=IS

# Safety Factors (can be overridden in GUI)
SAFETY_FACTOR_STRUCTURAL=1.5
SAFETY_FACTOR_GEOTECHNICAL=3.0

# ===== Reporting Settings =====
# Report Format: PDF, DOCX
DEFAULT_REPORT_FORMAT=PDF

# Include Charts in Reports
INCLUDE_CHARTS=true

# Company Information (for reports)
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your Address
COMPANY_LOGO_PATH=assets/company_logo.png

# ===== Advanced Settings =====
# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Cache Analysis Results
ENABLE_CACHE=true

# Auto-save interval (seconds, 0 to disable)
AUTO_SAVE_INTERVAL=300

# Maximum concurrent analyses
MAX_CONCURRENT_ANALYSES=3
